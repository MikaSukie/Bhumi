import C_std;

fn main() <void> {
    Exist<string> thepath = Exist->Some(input("file path?: "));
    match (thepath) {
        Some(contents) {
            printnl("path is: " + contents);
        }
        None {
            printnl("Null err");
        }
    }
    Respond<string, string> infile = try_read_file(thepath);
    match (infile) {
        Ok(contents) {
            printnl(contents);
        }
        Err(e) {
            printnl(e);
        }
    }
}
