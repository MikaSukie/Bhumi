import C_std;

fn main() <void> {
    autoregion {
        string s = input("file path?: ");

        Exist<string> thepath = Exist->Some(s);
        match (thepath) {
            Some(contents): {
                printnl("path is: " + contents);
            }
            None: {
                printnl("Null err");
            }
        }

        Respond<string, string> ff = try_read_file(thepath);
        Respond<string, string> infile = ff;
        match (infile) {
            Ok(contents): {
                printnl(contents);
                free(contents);
            }
            Err(e): {
                printnl(e);
            }
        }
    }
}

pub fn try_read_file(Exist<string> path) <Respond<string, string>> {
    autoregion {
        match (path) {
            Some(p): {
                if (file_exists(p)) {
                    return Ok(read_file(p));
                } else {
                    return Err("Error reading file");
                }
            }
            None: {
                return Err("No path given");
            }
        }
    }
}

pub extern fn read_file(string path) <string>;
pub extern fn file_exists(string path) <bool>;
