// raylib.bhumi
// Complete Raylib bindings for Bhumi
// Compile & link with: -lraylib -lm -ldl -lpthread (Linux)
//                      -lraylib -framework... (macOS)
//                      raylib.lib (Windows)
//
// ============================================================
// Structs
// ============================================================

struct Vector2 {
    float32 x;
    float32 y;
}

struct Vector3 {
    float32 x;
    float32 y;
    float32 z;
}

struct Vector4 {
    float32 x;
    float32 y;
    float32 z;
    float32 w;
}

struct Rectangle {
    float32 x;
    float32 y;
    float32 width;
    float32 height;
}

packed struct Color {
    uint8 r;
    uint8 g;
    uint8 b;
    uint8 a;
}

struct Texture {
    uint32 id;
    int32  width;
    int32  height;
    int32  mipmaps;
    int32  format;
}

struct RenderTexture {
    uint32  id;
    Texture texture;
    Texture depth;
}

struct Image {
    void* data;
    int32 width;
    int32 height;
    int32 mipmaps;
    int32 format;
}

struct Font {
    int32   baseSize;
    int32   glyphCount;
    int32   glyphPadding;
    Texture texture;
    void*   recs;
    void*   glyphs;
}

struct Camera2D {
    Vector2 offset;
    Vector2 target;
    float32 rotation;
    float32 zoom;
}

struct Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    float32 fovy;
    int32   projection;
}

struct Ray {
    Vector3 position;
    Vector3 direction;
}

struct BoundingBox {
    Vector3 min;
    Vector3 max;
}

struct NPatchInfo {
    Rectangle source;
    int32     left;
    int32     top;
    int32     right;
    int32     bottom;
    int32     layout;
}

struct AudioStream {
    void*  buffer;
    void*  processor;
    uint32 sampleRate;
    uint32 sampleSize;
    uint32 channels;
}

struct Wave {
    uint32 frameCount;
    uint32 sampleRate;
    uint32 sampleSize;
    uint32 channels;
    void*  data;
}

struct Sound {
    AudioStream stream;
    uint32      frameCount;
}

struct Music {
    AudioStream stream;
    uint32      frameCount;
    bool        looping;
    int32       ctxType;
    void*       ctxData;
}

