// ============================================================
// Color helpers
// ============================================================

fn ColorRGBA(uint8 r, uint8 g, uint8 b, uint8 a) <int32> {
    return ((int32) a << 24) | ((int32) b << 16) | ((int32) g << 8) | (int32) r;
}

fn MakeColor(uint8 r, uint8 g, uint8 b, uint8 a) <Color> {
    Color c;
    c.r = r;
    c.g = g;
    c.b = b;
    c.a = a;
    return c;
}

pin nomd Color LIGHTGRAY  = MakeColor(200, 200, 200, 255);
pin nomd Color GRAY       = MakeColor(130, 130, 130, 255);
pin nomd Color DARKGRAY   = MakeColor(80,  80,  80,  255);
pin nomd Color YELLOW     = MakeColor(253, 249, 0,   255);
pin nomd Color GOLD       = MakeColor(255, 203, 0,   255);
pin nomd Color ORANGE     = MakeColor(255, 161, 0,   255);
pin nomd Color PINK       = MakeColor(255, 109, 194, 255);
pin nomd Color RED        = MakeColor(230, 41,  55,  255);
pin nomd Color MAROON     = MakeColor(190, 33,  55,  255);
