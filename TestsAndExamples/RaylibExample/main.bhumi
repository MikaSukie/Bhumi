import CRaylib, C_std;

fn main() <int> {
    Color red = Color { r(255); g(50); b(255); a(255); }

    float32 pos_x = 0.0;
    float32 pos_y = 0.0;

    float32 vel_x = 197.0;
    float32 vel_y = 151.0;

    int32 rect_size = 100;
    int32 screen_width = 800;
    int32 screen_height = 450;

    uint8 r = 150;
    uint8 g = 255;
    uint8 b = 128;

    InitWindow(screen_width, screen_height, "Colorful DVD");
    SetTargetFPS(60);

    while (!WindowShouldClose()) {
        float32 dt = GetFrameTime();

        pos_x += vel_x * dt;
        pos_y += vel_y * dt;

        if (pos_x <= 0.0) {
            pos_x = 0.0;
            vel_x = -vel_x;

            r += 47;
            g += 83;
            b += 29;
        } else if (pos_x + (float32) rect_size >= (float32) screen_width) {
            pos_x = (float32) screen_width - rect_size;
            vel_x = -vel_x;

            r += 47;
            g += 83;
            b += 29;
        }

        if (pos_y <= 0.0) {
            pos_y = 0.0;
            vel_y = -vel_y;

            r += 47;
            g += 83;
            b += 29;
        } else if (pos_y + (float32) rect_size >= (float32) screen_height) {
            pos_y = (float32) screen_height - rect_size;
            vel_y = -vel_y;

            r += 47;
            g += 83;
            b += 29;
        }

        BeginDrawing();
        ClearBackground(/*ColorRGBA(50, 50, 50, 50)*/red);
        DrawText("Welcome to DVD on Bhumi", 80, 200, 48, 0xFF000000);
        DrawRectangle(ftoint(pos_x), ftoint(pos_y), rect_size, rect_size, ColorRGBA(r, g, b, 255));
        EndDrawing();
    }

    CloseWindow();
}
